# Environment Variables for NAVI AI Chat Interface
# Copy this file to .env.local and fill in your actual API keys

# Gemini 2.0 Flash API Key
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs TTS API Configuration
NEXT_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
NEXT_PUBLIC_ELEVENLABS_VOICE_ID=your_voice_id_here

# Optional: Custom API endpoints
# NEXT_PUBLIC_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# NEXT_PUBLIC_ELEVENLABS_API_URL=https://api.elevenlabs.io/v1